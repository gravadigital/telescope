# =====================================================================
# Telescopio API - Variables de entorno
# ---------------------------------------------------------------------
# Copiar a .env y ajustar:   cp .env.example .env
#
# Estos valores sirven para levantar el stack con Docker Compose
# (API + PostgreSQL + MinIO). Ver README.md.
# =====================================================================

# --- Puertos publicados en tu máquina ---------------------------------
API_PORT=8080
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PGADMIN_PORT=5050

# --- Base de datos (PostgreSQL) ---------------------------------------
# Dentro de Docker la API se conecta al servicio "postgres" por la red
# interna; estas credenciales se usan para crear e ingresar a la base.
POSTGRES_DB=telescopio_db
POSTGRES_USER=telescopio
POSTGRES_PASSWORD=telescopio_password
DB_SSLMODE=disable

# --- Servidor ---------------------------------------------------------
GIN_MODE=release
MAX_FILE_SIZE=10485760

# Secreto para firmar los JWT. OBLIGATORIO: sin esto el stack no arranca.
# Generar con: openssl rand -base64 32
JWT_SECRET=

# URL de la web (se usa en los links de los emails y en el CORS)
FRONTEND_URL=http://localhost:3000

# --- CORS -------------------------------------------------------------
# En local "*" está bien; en producción poner la URL exacta de la web.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Length,Content-Type,Authorization

# --- Almacenamiento de archivos ---------------------------------------
# "minio" (recomendado, se levanta con el stack) o "local" (volumen del contenedor)
STORAGE_PROVIDER=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=telescopio
MINIO_REGION=us-east-1

# --- Google OAuth (opcional) ------------------------------------------
# Si queda vacío, sólo se puede entrar con email + contraseña.
# Tiene que ser el MISMO client id que usa la web.
GOOGLE_CLIENT_ID=

# --- Email / SMTP (opcional) ------------------------------------------
# Con EMAIL_ENABLED=false no se envían mails (recuperación de contraseña,
# invitaciones a eventos).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_FROM_NAME=Telescopio

# --- pgAdmin (opcional, profile "tools") ------------------------------
PGADMIN_EMAIL=admin@telescopio.com
PGADMIN_PASSWORD=admin123

# =====================================================================
# Desarrollo SIN Docker (go run ./cmd/api)
# ---------------------------------------------------------------------
# La API lee estas variables directamente. Descomentar y apuntar a un
# PostgreSQL accesible desde tu máquina:
#
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=telescopio
# DB_PASSWORD=telescopio_password
# DB_NAME=telescopio_db
# PORT=8080
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_PATH=./uploads
# MINIO_ENDPOINT=localhost:9000
# =====================================================================
