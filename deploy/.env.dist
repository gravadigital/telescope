# Copiar a .env y completar. El .env resultante NO se versiona.
#
# En una máquina de desarrollo alcanza con completar JWT_SECRET: todo lo demás ya viene
# apuntado al stack local que levanta ./local.sh.

# ============================================
# VERSIONES
# ============================================
# Qué tag de imagen publicada levanta el compose de producción. Una por servicio:
# permite redesplegar la web sin tocar la api. NO es versionado independiente — el
# número es el mismo en las dos y lo fija scripts/set-version.sh.
#
# Para seguir la punta de dev: API_VERSION=dev y WEB_VERSION=dev.
API_VERSION=0.1.0
WEB_VERSION=0.1.0

# ============================================
# GENERAL
# ============================================
ENVIRONMENT=dev
# Sólo producción: la red del nginx que hace de ingress y el dominio que sirve.
INGRESS_NETWORK=server-nginx
DOMAIN=telescope.dev.grava.io

# ============================================
# PUERTOS (sólo local)
# ============================================
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PGADMIN_PORT=5050

# ============================================
# BASE DE DATOS
# ============================================
POSTGRES_DB=telescope_db
POSTGRES_USER=telescope
POSTGRES_PASSWORD=telescope_password
DB_SSLMODE=disable
# Sólo producción: en local el compose apunta al servicio `database` por nombre.
DB_HOST=telescope-dev-database

# ============================================
# API
# ============================================
GIN_MODE=release
MAX_FILE_SIZE=10485760

# OBLIGATORIO: sin esto la api no puede firmar tokens y todo login falla.
# Generar con: openssl rand -base64 32
JWT_SECRET=

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Length,Content-Type,Authorization

# ============================================
# STORAGE (MinIO, S3-compatible)
# ============================================
STORAGE_PROVIDER=minio
# Sólo producción: en local el compose apunta al servicio `minio` por nombre.
MINIO_ENDPOINT=telescope-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=telescope
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# ============================================
# GOOGLE OAUTH (opcional)
# ============================================
# Si queda vacío, sólo se entra con email y contraseña. El client id tiene que ser el
# mismo que recibe la web como build-arg.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# EMAIL / SMTP (opcional)
# ============================================
# Con EMAIL_ENABLED=false no se manda ningún mail (recuperación de contraseña,
# invitaciones a eventos).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_FROM_NAME=Telescope

# ============================================
# PGADMIN (opcional, profile "tools")
# ============================================
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
