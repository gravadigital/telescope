IMAGES_TAG=dev
ENVIRONMENT=dev
INGRESS_NETWORK=server-nginx
DOMAIN=telescope.dev.grava.io

## DATABASE VARIABLES
POSTGRES_DB=telescope-db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass

## WEB VARIABLES
REACT_APP_API_URL=https://api.telescopio.dev.grava.io

## API VARIABLES
DB_SSLMODE=disable
DB_HOST=telescope-dev-database
GIN_MODE=release
MAX_FILE_SIZE=10485760
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Length,Content-Type,Authorization

# Storage Configuration - MinIO (S3-compatible object storage)
STORAGE_PROVIDER=minio

# MinIO Configuration
MINIO_ENDPOINT=telescope-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=telescopio
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

## PGADMIN VARIABLES (optional - profile: tools)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
