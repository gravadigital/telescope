{
  "name": "telescopio-web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4",
    "yaml": "^2.8.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 --ext .ts,.tsx --ignore-pattern '*.test.*' --ignore-pattern '__tests__' src/i18n src/domain src/components/ui src/components/layout src/pages/home src/pages/events-list src/pages/my-events src/pages/create-event src/components/events/event-preview src/components/events/edit-event-dialog src/components/events/share-dialog src/components/events/participants-table src/components/events/participants-dialog src/components/voting src/pages/event-detail src/components/events/pending-card src/components/events/events-table src/pages/not-found src/pages/login src/pages/register src/pages/forgot-password src/pages/reset-password src/pages/complete-profile src/components/auth src/hooks/useGoogleSignIn.ts src/pages/manage-event src/components/notifications src/pages/notifications src/context/NotificationsContext.tsx src/components/events/open-registration-dialog src/components/events/open-voting-dialog src/components/events/publish-results-dialog src/components/events/reminder-dialog src/components/events/edit-deadline-dialog"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/components/ui/**/*.tsx",
          "src/components/layout/**/*.tsx",
          "src/pages/home/**/*.tsx",
          "src/pages/events-list/**/*.tsx",
          "src/pages/my-events/**/*.tsx",
          "src/pages/create-event/**/*.tsx",
          "src/components/events/event-preview/**/*.tsx",
          "src/components/events/edit-event-dialog/**/*.tsx",
          "src/components/events/share-dialog/**/*.tsx",
          "src/components/events/participants-table/**/*.tsx",
          "src/components/events/participants-dialog/**/*.tsx",
          "src/components/voting/**/*.tsx",
          "src/pages/event-detail/**/*.tsx",
          "src/components/events/pending-card/**/*.tsx",
          "src/components/events/events-table/**/*.tsx",
          "src/pages/not-found/**/*.tsx",
          "src/pages/login/**/*.tsx",
          "src/pages/register/**/*.tsx",
          "src/pages/forgot-password/**/*.tsx",
          "src/pages/reset-password/**/*.tsx",
          "src/pages/complete-profile/**/*.tsx",
          "src/components/auth/**/*.tsx",
          "src/pages/manage-event/**/*.tsx",
          "src/components/notifications/**/*.tsx",
          "src/pages/notifications/**/*.tsx",
          "src/context/NotificationsContext.tsx",
          "src/components/events/open-registration-dialog/**/*.tsx",
          "src/components/events/open-voting-dialog/**/*.tsx",
          "src/components/events/publish-results-dialog/**/*.tsx",
          "src/components/events/reminder-dialog/**/*.tsx",
          "src/components/events/edit-deadline-dialog/**/*.tsx"
        ],
        "excludedFiles": [
          "**/*.test.tsx",
          "**/__tests__/**"
        ],
        "rules": {
          "react/jsx-no-literals": [
            "error",
            {
              "noStrings": false,
              "allowedStrings": [
                "·",
                "/",
                "—",
                "–",
                "×",
                "…",
                "→",
                "←",
                "↑",
                "↓",
                "+",
                "−",
                ":",
                "|",
                "(",
                ")",
                "%"
              ],
              "ignoreProps": true
            }
          ]
        }
      }
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/bonjour": "^3.5.13",
    "@types/estree": "^1.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/prettier": "^2.7.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/trusted-types": "^2.0.7",
    "typescript": "^4.9.5"
  }
}
