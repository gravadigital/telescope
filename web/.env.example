# =====================================================================
# Telescopio Web - Variables de entorno
# ---------------------------------------------------------------------
# Copiar a .env y ajustar:   cp .env.example .env
#
# ⚠️ IMPORTANTE: Create React App congela las variables REACT_APP_* en el
# momento del BUILD, no al arrancar. Después de cambiar cualquiera de
# estas hay que reconstruir:  docker compose up -d --build
# =====================================================================

# Puerto en el que se publica la web en tu máquina
WEB_PORT=3000

# URL de la API, tal como la ve el NAVEGADOR.
# Tiene que ser alcanzable desde el navegador: http://localhost:8080,
# nunca el nombre interno de un contenedor.
# Si la API corre en otro puerto, ajustar acá.
REACT_APP_API_URL=http://localhost:8080

# Login con Google (opcional).
# Si queda vacío, el botón "entrar con Google" no aparece y se usa sólo
# email + contraseña. Debe ser el MISMO client id configurado en la API.
REACT_APP_GOOGLE_CLIENT_ID=
